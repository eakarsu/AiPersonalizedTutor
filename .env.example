NODE_ENV=development
BACKEND_PORT=3001
FRONTEND_PORT=5173
CORS_ORIGINS=http://localhost:5173
DATABASE_URL=postgresql://app_user:replace_me@localhost:5432/ai_tutor_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ai_tutor_db
DB_USER=app_user
DB_PASSWORD=replace_me
JWT_SECRET=generate_a_unique_random_value_of_at_least_32_characters
ENABLE_LEGACY_PROVIDER_ROUTES=false
ENABLE_LEGACY_PUBLIC_INTAKE=false
ENABLE_LEGACY_SCHEMA_BOOTSTRAP=false
ALLOW_MOCK_PROVIDERS=false
ALLOW_DEMO_SEED=false
OPENROUTER_API_KEY=
LMS_CANVAS_BLACKBOARD_TOKEN=
STUDENT_INFORMATION_TOKEN=
CONTENT_REPOSITORY_TOKEN=
# Local-only demo autofill. The ignored .env must provide one complete
# DEMO_*, SEED_ADMIN_*, ADMIN_*, or DEFAULT_* email/password pair.
ENABLE_DEMO_CREDENTIAL_AUTOFILL=false
